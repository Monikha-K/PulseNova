# PulseNova Backend — copy this file to .env and adjust as needed

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Path to the dataset folder, relative to the project root
DATASET_DIR=../dataset

# API host and port (used for documentation only — pass to uvicorn directly)
API_HOST=127.0.0.1
API_PORT=8000
